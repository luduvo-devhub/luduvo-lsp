-- an axis-aligned rectangle, from its minimum corner to its maximum corner
export type Rect = {
    -- minimum corner coordinates
    Min: vector,
    -- maximum corner coordinates
    Max: vector,
    -- width of the rectangle along the horizontal axis
    Width: number,
    -- height of the rectangle along the vertical axis
    Height: number,

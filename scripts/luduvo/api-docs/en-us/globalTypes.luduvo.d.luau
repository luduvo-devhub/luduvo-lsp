    TakeDamage: (self: Instance, amount: number, attacker: Instance?) -> (),
    -- Interned id of the authored text. Set Text through the property panel or a script.
    Text: string,
    -- Color of the text
    TextColor3: vector,
    -- Pixels
    TextSize: number,
    -- Color of the text outline
    TextStrokeColor3: vector,
    -- Transparency of the text outline, 0 opaque to 1 invisible
    TextStrokeTransparency: number,
    -- Zero disables the MSDF outline
    TextStrokeWidth: number,
    -- Transparency of the text, 0 opaque to 1 invisible
    TextTransparency: number,
    -- Horizontal text alignment: Left, Center, or Right
    TextXAlignment: number,
    -- Vertical text alignment: Top, Center, or Bottom
    TextYAlignment: number,
    -- Color of the draggable thumb
    ThumbColor3: vector,
    -- Pixels
    ThumbSize: number,
    -- Transparency of the thumb, 0 opaque to 1 invisible
    ThumbTransparency: number,
    -- Color of the track behind the fill
    TrackColor3: vector,
    -- Pixels
    TrackThickness: number,
    -- Transparency of the track, 0 opaque to 1 invisible
    TrackTransparency: number,
    -- Surface transparency, 0 opaque to 1 invisible
    Transparency: number,
    -- Rest-pose twist axis, parent body frame
    TwistAxis: vector,
    -- Twist limit about Twist Axis; already degrees
    TwistMax: number,
    -- Twist limit about Twist Axis; already degrees
    TwistMin: number,
    -- CK_PARTS shape byte; one identity for render, raycast, physics
    Type: string,
    -- Opts into hit-testing and click/press events
    UIClickable: boolean,
    -- ScreenGui: top-level entity whose descendants form one overlay
    UIRoot: boolean,
    -- Second albedo, alpha-composited under Albedo over the part colour; read only where a BrickColor makes the mesh a decal
    Underlay: string,
    -- Account id of the player who controls this character

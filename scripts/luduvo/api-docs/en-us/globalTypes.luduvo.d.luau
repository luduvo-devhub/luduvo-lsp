-- an entity in the place tree; the components it holds add the members listed under each section
export type Instance = {
    -- Engine action this core menu button triggers
    Action: string,
    -- fires when the pointer clicks this element, client side only
    -- Read only at runtime.
    Activated: Signal,
    -- Prefab id of the currently held item
    Active: number,
    -- name of the playing animation clip, nil when none plays
    -- Server only.
    ActiveAnimation: (self: Instance) -> string?,
    -- attach a component by name and return it
    AddComponent: (self: Instance, name: ComponentName) -> Component | Instance,
    -- step the animation preview, false when no preview runs
    -- Server only.
    AdvancePreview: (self: Instance) -> boolean,
    -- Base color texture override; 0 keeps the material texture
    Albedo: string,
    -- Cross-axis alignment of the children: Start, Center, or End
    Align: string,
    -- Constraint pivot in the ECS parent's body frame
    Anchor: vector,
    -- Pivot inside the rect, 0,0 top left to 1,1 bottom right
    AnchorPoint: vector,
    -- Fixes the body in place; gravity and contacts cannot move it
    Anchored: boolean,
    -- Decay rate of angular velocity per second; 0 means no drag
    AngularDamping: number,
    -- animation layer rows of a character, indexed by layer
    -- Server only.
    -- Read only at runtime.
    AnimLayers: AnimLayers,
    -- state of the animation preview, nil when no preview runs
    -- Server only.
    AnimationPreview: (self: Instance) -> AnimPreviewInfo?,
    -- blend weight of a clip, nil when the entity has no animator
    -- Server only.
    AnimationWeight: (self: Instance, clip: string) -> number?,
    -- push the physics body with a force, optionally at a point
    -- Server only.
    ApplyForce: (self: Instance, force: vector, at: vector?) -> (),
    -- kick the physics body with an impulse, optionally at a point
    -- Server only.
    ApplyImpulse: (self: Instance, impulse: vector, at: vector?) -> (),
    -- spin the physics body with a torque
    -- Server only.
    ApplyTorque: (self: Instance, torque: vector) -> (),
    -- The entity that dealt the last damage
    -- Read only at runtime.
    Attacker: Instance?,
    -- Automatic walk/idle/jump clip selection from velocity and state
    AutoLocomotion: boolean,
    -- The character turns to the move direction
    AutoRotate: boolean,
    -- Direction the children stack: Vertical or Horizontal
    Axis: string,
    -- Background color of the frame
    BackgroundColor3: vector,
    -- Transparency of the frame background, 0 opaque to 1 invisible
    BackgroundTransparency: number,
    -- Draws the text with the bold font weight
    Bold: boolean,
    -- Color of the border stroke
    BorderColor3: vector,
    -- Pixels
    BorderSizePixel: number,
    -- Transparency of the border stroke, 0 opaque to 1 invisible
    BorderTransparency: number,
    -- Joint reaction force in Newtons that breaks the weld; zero holds forever
    BreakForce: number,
    -- Scrollable canvas size, a fraction of the frame plus pixels
    CanvasSize: UDim2,
    -- Pixels between cells
    CellPadding: number,
    -- Size of one grid cell in pixels
    CellSize: vector,
    -- fires after a property of the entity changes
    -- Read only at runtime.
    Changed: Signal,
    -- Marks the root entity of a humanoid character
    Character: boolean,
    -- Attaches an Animator once the six body parts exist
    CharacterAnimation: boolean,
    -- Opt-in dynamic torso body; Health and Locomotion alone are inert data
    CharacterPhysics: boolean,
    -- Kinematic limb bodies for the BodyPart children, ridden on the torso and pose
    CharacterRig: boolean,
    -- Scissors the descendants to this entity's rect
    ClipsDescendants: boolean,
    -- copy the entity with its descendants, the copy becomes a root
    Clone: (self: Instance) -> Instance,
    -- Auto derives from Shape (cone as cylinder, wedge as box)
    Collider: string,
    -- collision group name, Default when none is set
    CollisionGroup: string,
    -- Surface color of the part or mesh
    Color: vector,
    -- Cells across one grid line
    Columns: number,
    -- Pixels
    CornerRadius: number,
    -- Color of the text input cursor
    CursorColor3: vector,
    -- Transparency of the text cursor, 0 opaque to 1 invisible
    CursorTransparency: number,
    -- Mass per unit of volume used to derive the body mass
    Density: number,
    -- remove the entity and its descendants, no-op when already dead
    -- Server only.
    Destroy: (self: Instance) -> (),
    -- Draws the control dim and refuses the pointer and the key; absent means usable
    Disabled: boolean,
    -- Interned id of the account display name, set by the server session layer on join
    -- Read only at runtime.
    DisplayNameId: number,
    -- fires while the pointer drags this element, client side only
    -- Read only at runtime.
    DragMoved: Signal,
    -- Emissive color texture added to the lighting; 0 adds none
    Emissive: string,
    -- fire the named signal on the entity with the given arguments
    Emit: (self: Instance, name: string, ...any) -> (),
    -- Texture asset of the face decal
    Face: string,
    -- Color of the track between its start and the thumb
    FillColor3: vector,
    -- Transparency of the track fill, 0 opaque to 1 invisible
    FillTransparency: number,
    -- the direct child with the given name, nil when none
    FindFirstChild: (self: Instance, name: string) -> Instance?,
    -- Friction coefficient of contacts on this surface, 0 to 2
    Friction: number,
    -- Anti-jitter friction torque in Nm once the joint settles
    FrictionTorque: number,
    -- angular velocity of the physics body
    -- Server only.
    GetAngularVelocity: (self: Instance) -> vector,
    -- array of the direct children
    GetChildren: (self: Instance) -> {Instance},
    -- user id, display name, and admin flag, nil for non-players
    GetIdentity: (self: Instance) -> Identity?,
    -- linear velocity of the physics body
    -- Server only.
    GetLinearVelocity: (self: Instance) -> vector,
    -- mass of the physics body, nil when the entity has none
    GetMass: (self: Instance) -> number?,
    -- movement intent of a character, nil when the entity has none
    -- Server only.
    GetMoveIntent: (self: Instance) -> MoveIntent?,
    -- the named signal of the entity, created on first use
    GetSignal: (self: Instance, name: string) -> Signal,
    -- swing-twist joint parameters, nil when the entity has no joint
    GetSwingTwistJoint: (self: Instance) -> SwingTwistJointInfo?,
    -- whether the entity holds the named component
    HasComponent: (self: Instance, name: ComponentName) -> boolean,
    -- Current hit points; reaching 0 kills the character
    Health: number,
    -- Clearance between the floor and the torso in studs
    HipHeight: number,
    -- fires when the pointer enters this element, client side only
    -- Read only at runtime.
    Hovered: Signal,
    -- Team number of this entity. Team 0 means no team
    Id: number,
    -- The texture asset this element draws. 0 draws nothing.
    Image: string,
    -- Multiplies the texture; white keeps the source colors
    ImageColor3: vector,
    -- Transparency of the texture, 0 opaque to 1 invisible
    ImageTransparency: number,
    -- Half-angle in radians with full intensity inside the cone
    InnerAngle: number,
    -- whether local movement input drives this camera
    InputMove: boolean,
    -- whether local pointer input steers this camera
    InputSteer: boolean,
    -- Brightness of the emitted light; 0 turns it off
    Intensity: number,
    -- TakeDamage does nothing while this tag exists
    Invulnerable: boolean,
    -- whether the entity still exists in the world
    IsAlive: (self: Instance) -> boolean,
    -- whether the entity sits below the given ancestor
    IsDescendantOf: (self: Instance, ancestor: Instance) -> boolean,
    -- This entity is the root of an accessory prefab
    IsRoot: boolean,
    -- Offset in the torso frame
    Joint: vector,
    -- Upward velocity given on jump in studs/s
    JumpPower: number,
    -- Color of the sliding knob
    KnobColor3: vector,
    -- Pixels between the knob and the track
    KnobInset: number,
    -- Transparency of the knob, 0 opaque to 1 invisible
    KnobTransparency: number,
    -- Place order under a parent that has a UIListLayout
    LayoutOrder: number,
    -- Color of the emitted light
    LightColor: vector,
    -- The light casts no shadow. Absence means it casts
    LightShadowOff: boolean,
    -- Decay rate of linear velocity per second; 0 means no drag
    LinearDamping: number,
    -- YXZ Euler degrees relative to the parent
    LocalOrientation: vector,
    -- offset in studs relative to the parent
    LocalPosition: vector,
    -- Cannot be selected or moved in the editor viewport
    Locked: boolean,
    -- Pixels inside the bottom edge
    MarginBottom: number,
    -- Pixels inside the left edge
    MarginLeft: number,
    -- Pixels inside the right edge
    MarginRight: number,
    -- Pixels inside the top edge
    MarginTop: number,
    -- Inner margins in pixels: left, top, right, bottom
    Margins: Rect,
    -- surface material name, empty when none is set
    -- Server only.
    Material: string,
    -- Hit point cap that healing cannot exceed
    MaxHealth: number,
    -- Size cap, a fraction of the parent plus pixels; 0 means no cap
    MaxSize: UDim2,
    -- Floor angle in degrees a character walks on
    MaxSlopeAngle: number,
    -- The mesh asset this entity draws; 0 draws nothing
    Mesh: string,
    -- Roughness in green and metallic in blue; 0 keeps the material
    MetallicRoughness: string,
    -- entity name, empty when unset
    Name: string,
    -- Hash id of the entity name. Use the outliner to rename.
    -- Read only at runtime.
    NameId: number,
    -- Zero contact friction while present; the FSM holds it during GettingUp
    NoContactFriction: boolean,
    -- Show this text as typed, with no translation
    NoTranslate: boolean,
    -- Tangent-space normal map override; 0 keeps the material map
    Normal: string,
    -- Swing half-angle perpendicular to Plane Axis; already degrees
    NormalCone: number,
    -- Ambient occlusion texture, red channel; 0 keeps the material
    Occlusion: string,
    -- Track color while the switch is off
    OffColor3: vector,
    -- Track transparency while off, 0 opaque to 1 invisible
    OffTransparency: number,
    -- The switch is in the on position
    On: boolean,
    -- Track color while the switch is on
    OnColor3: vector,
    -- Track transparency while on, 0 opaque to 1 invisible
    OnTransparency: number,
    -- Widget operation: Show the value, or Previous and Next to cycle it
    Op: string,
    -- world rotation as YXZ Euler degrees
    Orientation: vector,
    -- The second welded entity; the weld holds the relative pose the two bodies had when the joint appeared
    Other: Instance?,
    -- Half-angle in radians where the light fades to zero
    OuterAngle: number,
    -- Core menu page this subtree belongs to
    Page: number,
    -- Texture asset of the pants
    Pants: string,
    -- parent entity, nil for a root
    Parent: Instance?,
    -- Which body part of the rig this entity is
    Part: string,
    -- Mask typed characters
    Password: boolean,
    -- Offset in the limb frame, negated
    Pivot: vector,
    -- Interned id of the placeholder text. Set PlaceholderText through the property panel or a script.
    PlaceholderText: string,
    -- Rest-pose swing ellipse axis, parent body frame
    PlaneAxis: vector,
    -- Swing half-angle toward Plane Axis; already degrees
    PlaneCone: number,
    -- play a clip with an optional fade time and speed
    -- Server only.
    PlayAnimation: (self: Instance, clip: string, fade: number?, speed: number?) -> (),
    -- world position in studs, a UDim2 on GUI elements
    Position: vector | UDim2,
    -- Id of the prefab this instance was spawned from
    PrefabId: number,
    -- start an animation preview, false when the clip is refused
    -- Server only.
    PreviewAnimation: (self: Instance, clip: string, playing: boolean?, time: number?, speed: number?) -> boolean,
    -- Distance the light reaches in studs
    Range: number,
    -- Seconds left before the server destroys the entity and its children
    Remaining: number,
    -- detach the named component from the entity

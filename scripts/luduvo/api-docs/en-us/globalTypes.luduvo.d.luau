    SetLinearVelocity: (self: Instance, velocity: vector) -> (),
    -- configure the swing-twist joint of the entity
    -- Server only.
    SetSwingTwistJoint: (self: Instance, joint: SwingTwistJointDesc) -> (),
    -- Device setting this widget shows or adjusts
    Setting: string,
    -- No shadow from this entity; the shadow passes skip it
    ShadowOff: boolean,
    -- Texture asset of the shirt
    Shirt: string,
    -- part size in studs, a UDim2 on GUI elements

    UserId: string,
    -- The place the thumb shows
    Value: number,
    -- Linear velocity in studs/s; live while the world simulates
    Velocity: vector,
    -- camera entity this screen renders from, nil when none
    ViewSource: Instance?,
    -- Draws the entity and its subtree; false hides them
    Visible: boolean,
    -- Ground movement speed of the character in studs/s
    WalkSpeed: number,
    -- Draw order among siblings; the higher one draws last
    ZIndex: number,
    -- attribute table of the entity, read and write as e.attr.Name
    -- Read only at runtime.
    attr: { [string]: number | boolean | string | vector },
    -- perspective projection settings for a camera entity
    CameraLens: { fovY: number, nearZ: number, farZ: number },
    -- third-person orbit camera controls; smoothed fields are written by the rig
    CameraOrbit: { distance: number, smoothDistance: number, smoothSideOffset: number, fade: number },
    -- free-camera yaw, pitch, and zoom controls
    CameraFly: { smoothDistance: number, smoothSideOffset: number, fade: number, [string]: number },
}

-- queries the physics world with rays, overlaps, and sweeps, and sets the collision groups and gravity the solver uses
export type PhysicsService = {
    -- register a named collision group
    -- Server only.
    RegisterCollisionGroup: (name: string) -> (),
    -- rename a collision group
    -- Server only.
    RenameCollisionGroup: (from: string, to: string) -> (),
    -- set whether two groups collide
    -- Server only.
    SetCollisionRule: (a: string, b: string, collidable: boolean) -> (),
    -- cast a ray and report the first hit
    Raycast: (origin: vector, dir: vector, maxDist: number, ignore: Instance?) -> RaycastResult?,
    -- collect the entities inside a sphere
    OverlapSphere: (center: vector, radius: number, out: {Instance}?) -> (number, {Instance}),
    -- whether the physics body of an entity sleeps
    IsSleeping: (e: Instance) -> boolean,
    -- collect the entities inside a rotated box
    OverlapBox: (center: vector, half: vector, rotation: vector?, out: {Instance}?) -> (number, {Instance}),
    -- sweep a box, a sphere, or a capsule and report every entity in the path, nearest first
    Shapecast: (shape: string, size: vector, from: vector, to: vector, rotation: vector?, out: {ShapecastHit}?) -> (number, {ShapecastHit}),
    -- drain the buffered touch begin and end events, second result reports lost events
    DrainTouchEvents: () -> ({TouchEvent}, boolean),
    -- break the welds inside a sphere and push the bodies out, result counts the bodies pushed
    -- Server only.
    Explode: (position: vector, radius: number, force: number) -> number,
    -- downward acceleration
    -- Server only.
    Gravity: number,
    -- height where fallen parts vanish
    -- Read only at runtime.
    FallenPartsDestroyHeight: number,
}

-- iterates the entities of the running place and registers the systems that run over them every tick
export type WorldService = {
    -- iterate the entities that hold a component
    Each: (name: ComponentName) -> () -> Instance?,
    -- print attribute usage to the output
    DumpAttributes: (entity: Instance?) -> (),
    -- build a cached multi-component query
    Query: (...ComponentName) -> Query,
    -- register a per-tick system over a query
    System: (name: string, q: Query, fn: (Query) -> (), phase: string?) -> (),
    -- the output screen whose ViewSource selects the active camera
    -- Read only at runtime.
    Screen: Instance,
    -- the active camera entity selected by the screen ViewSource
    -- Read only at runtime.
    Camera: Instance?,
}

-- marks entities with named tags and finds every entity with that tag
export type TagsService = {
    -- add a tag to an entity
    Add: (entity: Instance, tag: string) -> (),
    -- find all entities with a tag
    Find: (tag: string) -> {Instance},
    -- list tags on an entity
    Get: (entity: Instance) -> {string},
    -- check whether an entity has a tag
    Has: (entity: Instance, tag: string) -> boolean,
    -- remove a tag from an entity
    Remove: (entity: Instance, tag: string) -> (),
}

-- spawns saved prefabs by name and translates between prefab names and their numeric ids
export type PrefabsService = {
    -- spawn a prefab by name
    Spawn: (name: string) -> Instance?,
    -- whether a prefab exists
    Exists: (name: string) -> boolean,
    -- lookup a prefab numeric id by name
    Id: (name: string) -> number,
    -- lookup a prefab name by numeric id
    Name: (id: number) -> string?,
}

-- reports where the last tick spent its time and how long each script took
export type ProfilerService = {
    -- timings of the last frame
    Frame: () -> FrameStats?,
    -- per-script costs of the last frame
    Scripts: () -> {ScriptCost},
    -- scripts dropped from the profile
    Dropped: () -> number,
}

-- sets the sun, sky, ambient light, and exposure that the renderer meters the scene with
export type LightingService = {
    -- sun direction, tint, and strength
    -- Read only at runtime.
    Sun: { Azimuth: number, Elevation: number, Tint: vector, Intensity: number },
    -- ambient light tint, strength, and source
    -- Read only at runtime.
    Ambient: { Tint: vector, Intensity: number, Source: number },
    -- background mode, color, and sky share of ambient light
    -- Read only at runtime.
    Sky: { Mode: number, Color: vector, Contribution: number },
    -- shadow mode and the light level inside shadows
    -- Read only at runtime.
    Shadows: { Mode: number, Fill: number },
    -- auto exposure bounds
    -- Read only at runtime.
    Exposure: { MinEV: number, MaxEV: number },
    -- night sky star brightness
    -- Read only at runtime.
    Stars: { Luminance: number },
    -- lens flare, intensity 0 disables it
    -- Read only at runtime.
    Flare: { Intensity: number, Scale: number, Tint: vector, Ghost: number },
}

-- reads the markers an animation clip crossed since the last drain, and names the body parts a blend layer may move
export type AnimationService = {
    -- drain the clip markers the sampler crossed, second result reports lost markers
    -- Server only.
    DrainMarkers: () -> ({{Entity: Instance, Clip: string, Marker: string}}, boolean),
    -- body part mask bits for AnimLayers rows
    -- Read only at runtime.
    Part: {Head: number, Torso: number, LeftArm: number, RightArm: number, LeftLeg: number, RightLeg: number},
}

-- plays a cooked sound at a point in the world on every client, and sets the volume of surface contact sounds
export type SoundService = {
    -- play a cooked sound at a world position on every client
    PlayAt: (assetId: string, position: vector, volume: number?) -> boolean,
    -- volume of surface contact sounds, 0 to 1
    -- Server only.
    SurfaceSoundsVolume: number,
}

-- reads and switches the active locale, and translates a key into the text of that locale
export type LocaleService = {
    -- the current locale tag
    Get: () -> string,
    -- switch the locale
    Set: (tag: string) -> (boolean, string),
    -- translate a key
    Translate: (key: string) -> string,
}

-- tracks the players on this server, the character each one drives, and the signals that fire as they join, leave, and die
export type SessionService = {
    -- bind a character entity to a user
    -- Server only.
    BindCharacter: (userId: number, character: Instance) -> (),
    -- the character bound to a user
    CharacterOf: (userId: number) -> Instance?,
    -- the character entity of the local client
    LocalCharacter: () -> Instance?,
    -- remove a player from this server
    -- Server only.
    Kick: (userId: number, reason: string?) -> boolean,
    -- fires when a player joins
    -- Read only at runtime.
    PlayerJoined: Signal,
    -- fires when a player leaves
    -- Read only at runtime.
    PlayerLeft: Signal,
    -- fires with the character, the user id, and the attacker
    -- Read only at runtime.
    CharacterDied: Signal,
}

-- reads the keyboard and mouse state of the local client, and the camera ray under the cursor
export type InputService = {
    -- whether a key is down
    KeyDown: (keyCode: number) -> boolean,
    -- whether a key was pressed this frame
    KeyPressed: (keyCode: number) -> boolean,
    -- whether a mouse button is down
    ButtonDown: (button: number) -> boolean,
    -- whether a mouse button was pressed this frame
    ButtonPressed: (button: number) -> boolean,
    -- camera ray through the cursor
    PointerRay: () -> (vector?, vector?),
}

-- loads the bytes of a place, a model, or an accessory in a scratch world and reports the facts it finds
export type ItemsService = {
    -- load item bytes in a scratch world and answer the facts
    -- Server only.
    Examine: (kind: string, bytes: string) -> {[string]: any},
}

-- opens a key-value store kept with the place, so its rows survive a restart
export type StoreService = {
    -- open the saved key store with that name
    -- Server only.
    open: (name: string) -> Store,
}

-- opens a key-value store that every server of the experience shares
export type CloudStoreService = {
    -- open the persistent cloud store with that name
    -- Server only.
    open: (name: string) -> CloudStore,
}

-- lists, defines, and replaces the materials that parts render with
export type MaterialsService = {
    -- list every material with its pipeline class and surface model
    GetMaterials: () -> {{Id: string, Name: string, Pipeline: string, Model: string}},
    -- read one material. An absent dataset is nil, never a flag
    GetMaterial: (idOrName: string) -> MaterialSpec,
    -- write the material file, define the material, and answer its asset id. An absent Name takes the next free store name
    -- Server only.
    DefineMaterial: (spec: MaterialSpec, parent: string?) -> string,
    -- delete the material and its file. A material in use needs a replacement
    -- Server only.
    RemoveMaterial: (idOrName: string, replacementIdOrName: string?) -> boolean,
    -- retarget every surface to the new material and delete the old one
    -- Server only.
    ReplaceMaterial: (oldIdOrName: string, newIdOrName: string) -> boolean,
    -- read the material file again and define the material in place
    -- Server only.
    ReloadMaterial: (idOrName: string) -> boolean,
}

-- 3D positions, directions, and velocities, with the axis and zero vectors alongside
declare Vector3: {
    -- make a vector
    new: (x: number, y: number, z: number) -> vector,
    -- the zero vector
    zero: vector,
    -- the all-ones vector
    one: vector,
    -- the x axis
    xAxis: vector,
    -- the y axis
    yAxis: vector,
    -- the z axis
    zAxis: vector,
}

-- UI positions and sizes that hold their layout when the viewport resizes
declare UDim2: {
    -- make a 2d dimension of scale and offset
    new: (scaleX: number?, offsetX: number?, scaleY: number?, offsetY: number?) -> UDim2,
}

-- 2D bounds such as UI margins and screen extents
declare Rect: {
    -- make a rectangle of two corners
    new: (minX: number?, minY: number?, maxX: number?, maxY: number?) -> Rect,
}

-- colors as red, green, and blue channels from 0 to 1
declare Color3: {
    -- make a color
    new: (r: number, g: number, b: number) -> vector,
}

-- 2D points such as screen pixels and UI anchors
declare Vector2: {
    -- make a 2d vector
    new: (x: number, y: number) -> vector,
}

-- write to the output
declare print: (...any) -> ()

-- write a warning to the output
declare warn: (...any) -> ()

-- seconds from a monotonic clock
declare tick: () -> number

-- print every event table to the output
declare EventTableDump: () -> ()

-- the entity this script runs on
declare self: Instance

-- named entities of this place
declare handles: { [string]: Instance }

-- what a ray hit: the entity, the point, the surface normal, and the distance
export type RaycastResult = {
    -- hit position in world space
    Position: vector,
    -- surface normal vector at the hit position
    Normal: vector,
    -- entity hit by the ray, or nil if none
    Entity: Instance?,
    -- distance from the ray origin to the hit position
    Distance: number,
}

-- what a swept shape hit, and how far along the sweep it struck
export type ShapecastHit = {
    -- entity hit by the swept shape
    Entity: Instance,
    -- contact point in world space
    Point: vector,
    -- surface normal vector at the contact point
    Normal: vector,
    -- fraction along the sweep path where the collision occurred
    Fraction: number,
}

-- two entities starting or stopping contact this frame
export type TouchEvent = {
    -- whether the contact began this frame or ended
    began: boolean,
    -- first entity involved in the contact
    a: Instance,
    -- second entity involved in the contact
    b: Instance,
}

-- where the last tick spent its time, and what Lua holds in memory
export type FrameStats = {
    -- total simulation frame duration in seconds
    sim: number,
    -- elapsed time since the previous frame in seconds
    interval: number,
    -- time spent executing scripts in seconds
    script: number,
    -- time spent stepping physics simulation in seconds
    physics: number,
    -- time spent processing network packets in seconds
    network: number,
    -- time spent preparing render state in seconds
    render: number,
    -- total Lua garbage collector memory usage in kilobytes
    gcKB: number,
    -- Lua garbage collector allocation rate in kilobytes per second
    gcAllocKBs: number,
}

-- how often one script ran and how long each call took
export type ScriptCost = {
    -- entity id the script is attached to
    entity: number,
    -- source path of the script
    path: string,
    -- average execution time per call in seconds
    avg: number,
    -- number of times the script was invoked
    calls: number,
}

-- who a player is, and whether the account is an admin
export type Identity = {
    -- unique numeric user identifier
    userId: number,
    -- player display name
    displayName: string,
    -- whether the user has administrative privileges
    isAdmin: boolean,
}

-- where a character wants to move, and which way it should face
export type MoveIntent = {
    -- lateral movement input along the horizontal axis
    x: number,
    -- forward and backward movement input
    z: number,
    -- whether the jump action is active
    jump: boolean,
    -- whether shift-lock camera alignment is active
    shiftLock: boolean,
    -- desired character facing angle in radians
    targetYaw: number,
}

-- the axes and angle limits to build a swing-twist joint from
export type SwingTwistJointDesc = {
    -- anchor position of the joint in local space
    Anchor: vector,
    -- primary twist axis of the joint
    TwistAxis: vector,
    -- plane axis orthogonal to the twist axis
    PlaneAxis: vector,
    -- rest direction for swing limits
    RestAxis: vector?,
    -- maximum swing angle along the plane axis in radians
    PlaneCone: number,
    -- maximum swing angle along the normal axis in radians
    NormalCone: number,
    -- minimum twist angle limit in radians
    TwistMin: number,
    -- maximum twist angle limit in radians
    TwistMax: number,
    -- joint rotational friction coefficient
    Friction: number?,
}

-- the axes and angle limits a live swing-twist joint reports
export type SwingTwistJointInfo = {
    -- anchor position of the joint in local space
    Anchor: vector,
    -- primary twist axis of the joint
    TwistAxis: vector,
    -- plane axis orthogonal to the twist axis
    PlaneAxis: vector,
    -- rest direction for swing limits
    RestAxis: vector,
    -- maximum swing angle along the plane axis in radians
    PlaneCone: number,
    -- maximum swing angle along the normal axis in radians
    NormalCone: number,
    -- minimum twist angle limit in radians
    TwistMin: number,
    -- maximum twist angle limit in radians
    TwistMax: number,
    -- joint rotational friction coefficient
    Friction: number,
}

-- which clip the preview plays, and where playback sits
export type AnimPreviewInfo = {
    -- name of the currently playing animation clip
    clip: string?,
    -- current playback position in seconds
    time: number,
    -- playback speed multiplier
    speed: number,
    -- whether the preview animation is currently playing
    playing: boolean,
    -- whether playback state is shared across peers
    shared: boolean,
}

-- one blend layer: the clip it plays and how it mixes in
export type AnimLayerRow = {
    -- name of the animation clip to blend
    clip: string,
    -- playback position in seconds
    time: number?,
    -- blend weight multiplier from 0 to 1
    weight: number?,
    -- playback speed multiplier
    speed: number?,
    -- bone mask bitmask index for partial body playback
    mask: number?,
    -- whether the animation layer loops when finished
    loop: boolean?,
    -- whether layer transforms are added to base pose
    additive: boolean?,
}

-- an event you connect functions to
export type Signal = {
    -- connect a listener callback to be invoked when the signal is emitted
    Connect: (self: Signal, callback: (...any) -> ()) -> (),
    -- fire the signal, invoking all connected callbacks with the arguments
    Emit: (self: Signal, ...any) -> (),
}

-- the fields of one component, read and written by name
export type Component = { [string]: any }

-- the blend layers of a character, indexed by layer
export type AnimLayers = { [number]: AnimLayerRow }

-- the value type of one event table field
declare extern type EventFieldType with end

-- whether an event table travels to the server or to the clients
declare extern type EventDirection with end

-- one field of an event table, holding a value per event
export type EventColumn<T = any> = { [number]: T }

-- a batch of events the server and its clients send each other
export type EventTable = {
    -- Note that the exact Columns depend on the query terms or event blueprint.
    [string]: any,
    -- number of pending events in the frame buffer
    count: number,
    -- column containing the user ID of the sender for each event
    sender: EventColumn,
    -- append a new event entry to be broadcast
    Push: (self: EventTable, ...any) -> (),
    -- append a new event entry targeted to a specific user
    PushTo: (self: EventTable, userId: number, ...any) -> (),
}


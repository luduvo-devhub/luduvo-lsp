-- a store kept with the place, so its rows survive a restart
export type Store = {
    -- retrieve the record stored under key, or nil if no entry exists
    get: (self: Store, key: number | string) -> {[string]: any}?,
    -- write a table record under the given key
    put: (self: Store, key: number | string, value: {[string]: any}) -> (),
}

-- a store every server of the experience shares, read and written asynchronously
export type CloudStore = {
    -- load the record under key, invoking callback with data, version, and error
    fetch: (self: CloudStore, key: number | string, callback: (any, number, string?) -> ()) -> (),
    -- store value under key with optional expected version check
    put: (self: CloudStore, key: number | string, value: {[string]: any}, expect_version: number?, callback: ((number?, string?) -> ())?) -> (),
    -- read and update the record via a transform function
    update: (self: CloudStore, key: number | string, transform: (any, number) -> any, callback: ((number?, string?) -> ())?) -> (),
    -- delete the record under key
    remove: (self: CloudStore, key: number | string, callback: ((boolean, string?) -> ())?) -> (),
    -- list stored keys starting after cursor with optional limit
    keys: (self: CloudStore, after: string?, limit: number?, callback: ({string}, string?) -> ()) -> (),
}

-- the textures, pipeline class, and physical terms one material renders with
export type MaterialSpec = {
    -- id the material is defined and looked up under
    Id: string,
    -- name the material can be looked up under, in place of the id
    Name: string?,
    -- pipeline class the surfaces draw in: Opaque, Cutout, Transparent, Water, or Decal
    Pipeline: string,
    -- surface model the shader samples with: UV, Triplanar, or Stud
    Model: string,
    -- base color, normal, and ORM textures, with the tint, tiling, and multipliers applied to them
    Surface: {BaseColor: string?, Normal: string?, Orm: string?, Tint: {r: number, g: number, b: number, a: number}?, TileSize: number?, NormalStrength: number?, RoughnessMult: number?, MetallicMult: number?, AlphaCutoff: number?, Neon: boolean?, TintVertex: boolean?},
    -- emissive texture, and the tint and intensity it radiates at
    Emission: {Texture: string?, Tint: {r: number, g: number, b: number}?, Intensity: number?}?,
    -- top and bottom stud textures the Stud surface model draws
    Studs: {ColorTop: string?, NormalTop: string?, ColorBottom: string?, NormalBottom: string?, StudsPerTile: number?}?,
    -- absorption, refraction, foam, and wave terms the Water pipeline class solves
    Water: {Absorption: {r: number, g: number, b: number}?, DepthScale: number?, Refraction: number?, FoamScale: number?, FoamDepth: number?, FlowSpeed: number?, FlowScale: number?, WaveAmplitude: number?, WaveScale: number?, WaveSpeed: number?, FlowMap: string?, Foam: string?}?,
    -- density, friction, and restitution the solver gives the surfaces
    Physics: {Density: number?, Friction: number?, Restitution: number?}?,
    -- clips a character plays walking on the surfaces, and the gain and pitch spread they play at
    Footsteps: {Clips: {string}, Gain: number?, PitchSpread: number?}?,
    -- clips a contact plays against the surfaces, and the gain and pitch spread they play at
    Impacts: {Clips: {string}, Gain: number?, PitchSpread: number?}?,
}

export type EventTableFactory = ((name: string, direction: EventDirection, fields: {{string | EventFieldType}}) -> EventTable) & {
    ToServer: EventDirection,
